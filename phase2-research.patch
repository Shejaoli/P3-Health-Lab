+/* ==========================================================================
+   Phase 2: Research page (lab's six themes)
+   ========================================================================== */
+.research-page .page-hero { padding: 64px 0 52px; }
+.research-page .page-hero h1 { max-width: 760px; margin: 14px 0 20px; font-size: clamp(1.9rem, 4.4vw, 3rem); line-height: 1.12; letter-spacing: -.025em; font-weight: 600; }
+.research-page .page-hero p { max-width: 720px; font-size: 1.02rem; }
+
+.research-intro { padding: 56px 0; border-bottom: 1px solid hsl(var(--border)); }
+.research-intro-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px 64px; }
+.research-intro h2 { margin: 0 0 12px; font-family: var(--app-font-serif); font-size: 1.2rem; font-weight: 600; }
+.research-intro p { max-width: 520px; margin: 0; color: hsl(var(--muted-foreground)); line-height: 1.7; }
+.research-intro ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
+.research-intro li a { color: hsl(var(--primary)); font-size: .95rem; line-height: 1.4; border-bottom: 1px solid transparent; }
+.research-intro li a:hover { border-bottom-color: hsl(var(--primary) / .5); }
+
+.research-themes { padding: 24px 0 8px; }
+.theme { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 16px 48px; padding: 44px 0; border-bottom: 1px solid hsl(var(--border)); scroll-margin-top: 72px; }
+.theme:last-child { border-bottom: 0; }
+.theme h2 { margin: 0; font-family: var(--app-font-serif); font-size: clamp(1.3rem, 2.2vw, 1.6rem); font-weight: 600; line-height: 1.25; letter-spacing: -.015em; }
+.theme-body p { max-width: 640px; margin: 0 0 14px; color: hsl(var(--muted-foreground)); line-height: 1.75; }
+.theme-body p:first-of-type { color: hsl(var(--foreground)); }
+.theme-figure { margin: 0 0 22px; }
+.theme-figure img { display: block; width: 100%; max-width: 640px; height: auto; border: 1px solid hsl(var(--border)); }
+.theme-figure figcaption { margin-top: 6px; color: hsl(var(--muted-foreground)); font-size: .78rem; }
+.theme-related { margin-top: 4px; font-size: .92rem; }
+.research-more { border-bottom: 0; border-top: 1px solid hsl(var(--border)); padding: 40px 0 56px; }
+.research-links { display: flex; flex-wrap: wrap; gap: 12px 32px; margin: 0; padding: 0; list-style: none; }
+
+@media (max-width: 760px) {
+  .research-page .page-hero { padding: 44px 0 36px; }
+  .research-intro { padding: 40px 0; }
+  .research-intro-grid { grid-template-columns: 1fr; }
+  .theme { grid-template-columns: 1fr; padding: 32px 0; }
+}
